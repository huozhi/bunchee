{
  "name": "unbundle-dual-format",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plain": {
      "import": "./dist/plain.js",
      "require": "./dist/plain.cjs"
    }
  }
}
